# Host port for the web UI.
LGFM_PORT=3002

# Listen only on the Docker host by default. Set 0.0.0.0 explicitly for
# trusted LAN/VPN access, preferably behind HTTPS.
LGFM_BIND_ADDR=127.0.0.1

# Stable Docker volume name. Do not change this after installation unless you
# intentionally migrate the application database.
LGFM_DATA_VOLUME=liquid-glass-file-manager_app-state

# Runtime identity used for Linux bind-mount permissions.
PUID=1000
PGID=1000
UMASK=022

# Set true only when the app is served through HTTPS.
LGFM_SECURE_COOKIE=false

# Authentication policy.
LGFM_LOGIN_RATE_LIMIT_MAX=10
LGFM_LOGIN_RATE_LIMIT_SEC=60
LGFM_SESSION_TTL_HOURS=12

# Number of state/config backup pairs retained by scripts/backup.sh.
LGFM_BACKUP_RETENTION=10
