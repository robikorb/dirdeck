# Host port for the web UI.
LGFM_PORT=3002

# Stable Docker volume name. Do not change this after installation unless you
# intentionally migrate the application database.
LGFM_DATA_VOLUME=liquid-glass-file-manager_app-state

# Runtime identity used for Linux bind-mount permissions.
PUID=1000
PGID=1000
UMASK=022

# Set true only when the app is served through HTTPS.
LGFM_SECURE_COOKIE=false
